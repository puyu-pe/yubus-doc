{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Machine-enforced contract for the YUBUS documentation inventory.",
    "title": "YUBUS documentation inventory",
    "type": "object",
    "required": [
        "version",
        "review_status",
        "review_note",
        "pages"
    ],
    "properties": {
        "version": {
            "const": 1
        },
        "review_status": {
            "enum": [
                "inventory_only",
                "semantically_reviewed"
            ]
        },
        "review_note": {
            "type": "string",
            "minLength": 1
        },
        "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "path",
                    "status",
                    "reviewed"
                ],
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "path": {
                        "type": "string",
                        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^/].*\\.md$"
                    },
                    "status": {
                        "enum": [
                            "registered",
                            "source_traced"
                        ]
                    },
                    "reviewed": {
                        "type": "boolean"
                    }
                }
            }
        }
    },
    "additionalProperties": false
}
